<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Studio da Andri</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #000;
    color: #fff;
    font-family: Arial, sans-serif;
}

header {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
    background: linear-gradient(145deg, #000, #292929, #000);
}

header h1 {
    font-family: Georgia, serif;
    font-size: 55px;
    margin: 20px 0;
}

header p {
    font-size: 17px;
    color: #ddd;
}

.estrela {
    font-size: 25px;
    margin: 15px;
}

.botao {
    display: inline-block;
    background: white;
    color: black;
    padding: 15px 25px;
    margin-top: 25px;
    text-decoration: none;
    border-radius: 30px;
    font-weight: bold;
    transition: .3s;
}

.botao:hover {
    background: #999;
    transform: scale(1.05);
}

section {
    padding: 65px 20px;
    text-align: center;
}

h2 {
    font-family: Georgia, serif;
    font-size: 35px;
    margin-bottom: 30px;
}

.servicos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.card {
    background: white;
    color: black;
    width: 250px;
    padding: 30px 20px;
    border-radius: 15px;
    transition: .3s;
}

.card:hover {
    transform: translateY(-8px);
}

.card h3 {
    font-family: Georgia, serif;
    font-size: 25px;
    margin: 15px 0;
}

.preco {
    font-size: 22px;
    font-weight: bold;
}

.horarios {
    max-width: 450px;
    margin: auto;
}

.horarios p {
    padding: 18px;
    border-bottom: 1px solid white;
    font-size: 17px;
}

.contato {
    background: white;
    color: black;
}

.contato p {
    margin: 15px;
}

.contato .botao {
    background: black;
    color: white;
}

footer {
    background: black;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 43px;
    }

    .card {
        width: 100%;
        max-width: 320px;
    }
}
</style>
</head>

<body>

<header>
    <div class="estrela">✦ ✧ ✦</div>

    <h1>Studio da Andri</h1>

    <p>Beleza em cada detalhe ♡</p>

    <div class="estrela">✧ ✦ ✧</div>

    <a href="#servicos" class="botao">
        CONHEÇA NOSSOS SERVIÇOS
    </a>
</header>

<section id="servicos">
    <h2>Serviços & Valores</h2>

    <div class="estrela">✦ ✧ ✦</div>

    <div class="servicos">

        <div class="card">
            <h3>Molde F1</h3>
            <p>Alongamento de unhas</p>
            <br>
            <div class="preco">R$ 130,00</div>
        </div>

        <div class="card">
            <h3>Esmaltação em Gel</h3>
            <p>Beleza e durabilidade</p>
            <br>
            <div class="preco">R$ 50,00</div>
        </div>

        <div class="card">
            <h3>Soft</h3>
            <p>Alongamento de unhas</p>
            <br>
            <div class="preco">R$ 120,00</div>
        </div>

    </div>
</section>

<section id="horarios">
    <h2>Horários de Atendimento</h2>

    <div class="estrela">✦ ✧ ✦</div>

    <div class="horarios">

        <p>Quinta-feira: 7:30 às 11:30</p>

        <p>Sexta-feira: 7:30 às 11:30</p>

        <p>Sábado: 8:00 às 17:30</p>

    </div>
</section>

<section class="contato">
    <h2>Agende seu horário!</h2>

    <p>Será um prazer cuidar de você! ♡</p>

    <a
    href="https://wa.me/5555991467965?text=Ol%C3%A1%2C%20Andri!%20Gostaria%20de%20agendar%20um%20hor%C3%A1rio."
    target="_blank"
    class="botao">

        AGENDAR PELO WHATSAPP

    </a>
</section>

<footer>
    <div class="estrela">✦ ✧ ✦</div>

    <p>© 2026 Studio da Andri</p>

    <p>Feito com carinho ♡</p>
</footer>

</body>
</html>
